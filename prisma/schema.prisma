generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Credentials {
  id                      String                   @id @default(uuid())
  authId                  String                   @unique @map("auth_id") @db.Uuid
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  isVerified              Boolean                  @default(false) @map("is_verified")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]

  @@map("credentials")
}

model RefreshToken {
  id            String      @id @default(uuid())
  credentialsId String      @map("credentials_id")
  tokenHash     String      @unique @map("token_hash")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  credentials   Credentials @relation(fields: [credentialsId], references: [id], onDelete: Cascade)

  @@index([credentialsId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id            String      @id @default(uuid())
  credentialsId String      @map("credentials_id")
  tokenHash     String      @unique @map("token_hash")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  credentials   Credentials @relation(fields: [credentialsId], references: [id], onDelete: Cascade)

  @@index([credentialsId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id            String      @id @default(uuid())
  credentialsId String      @map("credentials_id")
  tokenHash     String      @unique @map("token_hash")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  credentials   Credentials @relation(fields: [credentialsId], references: [id], onDelete: Cascade)

  @@index([credentialsId])
  @@map("email_verification_tokens")
}

model User {
  id                   String       @id @default(uuid())
  authId               String       @unique @map("auth_id") @db.Uuid
  email                String?
  phone                String?
  firstName            String       @map("first_name")
  lastName             String?      @map("last_name")
  avatar               String?
  roles                UserRole[]
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitedByInvitations Invitation[] @relation("UserInvitedBy")
  sentInvitations      Invitation[] @relation("UserInvitations")

  @@map("users")
}

model UserActivity {
  id           String           @id @default(uuid())
  authId       String           @map("auth_id") @db.Uuid
  activityType UserActivityType @map("activity_type")
  performedBy  String?          @map("performed_by")
  details      Json             @default("{}")
  timestamp    DateTime         @default(now()) @db.Timestamptz(6)
  ipAddress    String?          @map("ip_address")
  userAgent    String?          @map("user_agent")
  metadata     Json?            @default("{}")
  success      Boolean          @default(true)
  location     String?
  device       String?
  client       String?
  os           String?

  @@index([authId])
  @@index([timestamp])
  @@index([activityType])
  @@map("user_activities")
}

model Invitation {
  id         String           @id @default(uuid())
  code       String           @unique
  inviterId  String           @map("inviter_id")
  message    String?
  email      String?
  status     InvitationStatus @default(PENDING)
  acceptedBy String?          @map("accepted_by")
  acceptedAt DateTime?        @map("accepted_at")
  expiresAt  DateTime?        @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitee    User?            @relation("UserInvitedBy", fields: [acceptedBy], references: [id])
  inviter    User             @relation("UserInvitations", fields: [inviterId], references: [id])

  @@index([inviterId])
  @@index([code])
  @@map("invitations")
}

enum UserRole {
  USER
  MODERATOR
  EDITOR
  ADMIN
  ROOT

  @@map("user_role")
}

enum UserActivityType {
  REGISTRATION
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  PROFILE_UPDATE
  AVATAR_UPDATE
  EMAIL_UPDATE
  PHONE_UPDATE
  ACCOUNT_CREATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_ACTIVATED
  ACCOUNT_DELETED
  ROLE_CHANGE
  SECURITY_ALERT
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED

  @@map("user_activity_type")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED

  @@map("invitation_status")
}
