{{> header appName=appName subject="Welcome"}}

    <h1>Welcome, {{firstName}}!</h1>
    <p>
      Thank you for creating your account. We're excited to have you on board.
    </p>
    <p>
      To get started, please verify your email address by clicking the button below.
      This helps us keep your account secure.
    </p>

    <div class="cta-wrapper">
      <a href="{{{verificationLink}}}" class="btn-primary">Verify Email Address</a>
    </div>

    <div class="info-box">
      <p>This verification link will expire in <strong>24 hours</strong>. If it expires, you can request a new one from your account settings.</p>
    </div>

    <hr class="divider" />

    <p>If the button above doesn't work, copy and paste the following link into your browser:</p>
    <div class="token-box">{{{verificationLink}}}</div>

    <p>If you did not create this account, please ignore this email or <a href="mailto:support@{{appDomain}}" style="color:#4f46e5;">contact our support team</a>.</p>

{{> footer appName=appName appDomain=appDomain year=year}}
