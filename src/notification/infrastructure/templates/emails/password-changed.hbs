{{> header appName=appName subject="Your Password Has Been Changed"}}

    <h1>Your Password Was Changed</h1>
    <p>
      This is a confirmation that the password for your account
      <strong>{{email}}</strong> was recently changed.
    </p>

    <div class="info-box">
      <p>
        📅 <strong>Date &amp; Time:</strong> {{changedAt}}<br />
        🌐 <strong>IP Address:</strong> {{ipAddress}}
      </p>
    </div>

    <hr class="divider" />

    <div class="alert-box">
      <p>
        <strong>Didn't make this change?</strong> If you did not change your password, your account may have been compromised.
        Please <a href="mailto:support@{{appDomain}}" style="color:#92400e;font-weight:600;">contact our support team immediately</a>.
      </p>
    </div>

    <p>For your security, you may also want to:</p>
    <ul style="padding-left: 20px; margin-bottom: 16px; color: #555555; line-height: 1.8; font-size: 16px;">
      <li>Review your recent account activity</li>
      <li>Enable two-factor authentication if not already active</li>
      <li>Update passwords for any other accounts that used the same password</li>
    </ul>

{{> footer appName=appName appDomain=appDomain year=year}}
